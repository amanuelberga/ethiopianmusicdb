# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API). Use the publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Cloudflare Turnstile site key (the secret key goes in Supabase Auth > CAPTCHA, not here)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Public URL of the site (no trailing slash), used for canonical URLs, sitemap and OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: contact address shown on the legal pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Server-only: protects the /api/keepalive cron route (Vercel sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string

# Server-only, optional: YouTube Data API v3 key for "Start from a link" on /contribute. Without it, YouTube links
# show "not set up yet" (Spotify links still work). Restrict the key to the YouTube Data API in Google Cloud.
YOUTUBE_API_KEY=
